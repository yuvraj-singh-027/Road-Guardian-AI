# ====================================================================
# ROAD GUARDIAN AI — FRONTEND SUPABASE AUTH CONFIGURATION
# ====================================================================

# 1. Supabase Project Credentials (from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Authority Admin Credentials & Restrictions
# Comma-separated list of authorized authority emails
VITE_ADMIN_ALLOWED_EMAILS=admin@roadguardian.gov,chief.engineer@roadguardian.gov,director@pwd.gov
# Designated municipal authority passcode
VITE_ADMIN_PASSCODE=Admin@RoadGuardian2026
